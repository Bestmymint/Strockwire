{
  "name": "stockwise",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": "11.19.0"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present build",
    "dev:api": "pnpm --filter @stockwise/api dev",
    "dev:web": "pnpm --filter @stockwise/web dev",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "lint": "eslint .",
    "start:api": "pnpm --filter @stockwise/api start",
    "start:web": "pnpm --filter @stockwise/web start",
    "test": "pnpm --filter @stockwise/api prisma:generate && vitest run",
    "test:db": "pnpm --filter @stockwise/api test:db",
    "test:watch": "pnpm --filter @stockwise/api prisma:generate && vitest",
    "typecheck": "tsc --project tsconfig.json && pnpm --recursive --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.1",
    "eslint": "10.8.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  }
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED

  @@map("user_status")
}

enum OrganizationStatus {
  ACTIVE
  INACTIVE

  @@map("organization_status")
}

enum OrganizationRole {
  OWNER
  ADMIN
  BRANCH_MANAGER
  INVENTORY_STAFF
  CASHIER

  @@map("organization_role")
}

enum MembershipStatus {
  ACTIVE
  INACTIVE

  @@map("membership_status")
}

enum BranchStatus {
  ACTIVE
  INACTIVE

  @@map("branch_status")
}

enum BranchAssignmentStatus {
  ACTIVE
  INACTIVE

  @@map("branch_assignment_status")
}

enum InvitationRevocationReason {
  REPLACED
  CANCELLED
  DELIVERY_FAILED
  MEMBERSHIP_EXISTS

  @@map("invitation_revocation_reason")
}

enum MembershipAccessEventType {
  INVITATION_ACCEPTED
  ROLE_SCOPE_REPLACED
  DEACTIVATED
  REACTIVATED

  @@map("membership_access_event_type")
}

model User {
  id                String     @id @default(uuid()) @db.Uuid
  email             String     @unique(map: "users_email_key") @db.VarChar(320)
  passwordHash      String     @map("password_hash") @db.VarChar(255)
  status            UserStatus @default(ACTIVE)
  displayName       String?    @map("display_name") @db.VarChar(200)
  phone             String?    @db.VarChar(32)
  emailVerifiedAt   DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  passwordChangedAt DateTime   @default(now()) @map("password_changed_at") @db.Timestamptz(3)
  disabledAt        DateTime?  @map("disabled_at") @db.Timestamptz(3)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships             OrganizationMembership[]
  sessions                Session[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  acceptedInvitations     Invitation[]
  membershipAccessEvents  MembershipAccessEvent[]

  @@unique([id, email], map: "users_id_email_key")
  @@map("users")
}

model Organization {
  id            String             @id @default(uuid()) @db.Uuid
  name          String             @db.VarChar(200)
  status        OrganizationStatus @default(ACTIVE)
  deactivatedAt DateTime?          @map("deactivated_at") @db.Timestamptz(3)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships OrganizationMembership[]
  branches    Branch[]
  invitations Invitation[]

  @@map("organizations")
}

model OrganizationMembership {
  id             String           @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           OrganizationRole
  status         MembershipStatus @default(ACTIVE)
  deactivatedAt  DateTime?        @map("deactivated_at") @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization                Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user                        User                         @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  branchAssignments           BranchAssignment[]
  firstOrganizationOnboarding FirstOrganizationOnboarding?
  sourceInvitation            Invitation?                  @relation("MembershipSourceInvitation", fields: [sourceInvitationId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  sourceInvitationId          String?                      @map("source_invitation_id") @db.Uuid
  invitationsIssued           Invitation[]                 @relation("InvitationIssuer")
  invitationsRevoked          Invitation[]                 @relation("InvitationRevoker")
  targetAccessEvents          MembershipAccessEvent[]      @relation("MembershipAccessEventTarget")
  actorAccessEvents           MembershipAccessEvent[]      @relation("MembershipAccessEventActor")

  @@id([organizationId, userId], map: "organization_memberships_pkey")
  @@unique([organizationId, id], map: "organization_memberships_organization_id_id_key")
  @@unique([sourceInvitationId, organizationId], map: "organization_memberships_source_invitation_organization_key")
  @@index([userId, status, organizationId], map: "organization_memberships_user_status_idx")
  @@map("organization_memberships")
}

model Branch {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  code           String       @db.VarChar(50)
  name           String       @db.VarChar(200)
  phone          String?      @db.VarChar(32)
  address        String?      @db.VarChar(500)
  status         BranchStatus @default(ACTIVE)
  deactivatedAt  DateTime?    @map("deactivated_at") @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization                Organization                       @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  assignments                 BranchAssignment[]
  invitationBranchScopes      InvitationBranchScope[]
  membershipAccessEventScopes MembershipAccessEventBranchScope[]
  firstOrganizationOnboarding FirstOrganizationOnboarding?

  @@unique([organizationId, code], map: "branches_organization_id_code_key")
  @@unique([id, organizationId], map: "branches_id_organization_id_key")
  @@index([organizationId, status], map: "branches_organization_id_status_idx")
  @@map("branches")
}

model FirstOrganizationOnboarding {
  userId         String   @id @map("user_id") @db.Uuid
  organizationId String   @unique(map: "first_organization_onboardings_organization_id_key") @map("organization_id") @db.Uuid
  branchId       String   @map("branch_id") @db.Uuid
  requestHash    String   @map("request_hash") @db.VarChar(64)
  completedAt    DateTime @default(now()) @map("completed_at") @db.Timestamptz(3)

  membership OrganizationMembership @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Restrict, onUpdate: Restrict)
  branch     Branch                 @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, userId], map: "first_organization_onboardings_organization_id_user_id_key")
  @@unique([branchId, organizationId], map: "first_organization_onboardings_branch_id_organization_id_key")
  @@map("first_organization_onboardings")
}

model BranchAssignment {
  organizationId String                 @map("organization_id") @db.Uuid
  userId         String                 @map("user_id") @db.Uuid
  branchId       String                 @map("branch_id") @db.Uuid
  status         BranchAssignmentStatus @default(ACTIVE)
  deactivatedAt  DateTime?              @map("deactivated_at") @db.Timestamptz(3)
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  membership OrganizationMembership @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Restrict, onUpdate: Restrict)
  branch     Branch                 @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)

  @@id([organizationId, userId, branchId], map: "branch_assignments_pkey")
  @@unique([branchId, userId], map: "branch_assignments_branch_id_user_id_key")
  @@index([userId, status, organizationId], map: "branch_assignments_user_status_idx")
  @@index([branchId, status], map: "branch_assignments_branch_status_idx")
  @@map("branch_assignments")
}

model Session {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @unique(map: "sessions_token_hash_key") @map("token_hash") @db.VarChar(128)
  issuedAt          DateTime  @default(now()) @map("issued_at") @db.Timestamptz(3)
  lastUsedAt        DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  idleExpiresAt     DateTime  @map("idle_expires_at") @db.Timestamptz(3)
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  revocationReason  String?   @map("revocation_reason") @db.VarChar(100)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId, revokedAt, absoluteExpiresAt], map: "sessions_user_revoked_absolute_expiry_idx")
  @@map("sessions")
}

model EmailVerificationToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique(map: "email_verification_tokens_token_hash_key") @map("token_hash") @db.VarChar(128)
  issuedAt   DateTime  @default(now()) @map("issued_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedAt DateTime? @map("replaced_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId, expiresAt], map: "email_verification_tokens_user_expiry_idx")
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique(map: "password_reset_tokens_token_hash_key") @map("token_hash") @db.VarChar(128)
  issuedAt   DateTime  @default(now()) @map("issued_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedAt DateTime? @map("replaced_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId, expiresAt], map: "password_reset_tokens_user_expiry_idx")
  @@map("password_reset_tokens")
}

model Invitation {
  id                    String                      @id @default(uuid()) @db.Uuid
  organizationId        String                      @map("organization_id") @db.Uuid
  invitedEmail          String                      @map("invited_email") @db.VarChar(320)
  intendedRole          OrganizationRole            @map("intended_role")
  tokenHash             String                      @unique(map: "invitations_token_hash_key") @map("token_hash") @db.VarChar(128)
  issuedAt              DateTime                    @default(now()) @map("issued_at") @db.Timestamptz(3)
  expiresAt             DateTime                    @map("expires_at") @db.Timestamptz(3)
  consumedAt            DateTime?                   @map("consumed_at") @db.Timestamptz(3)
  revokedAt             DateTime?                   @map("revoked_at") @db.Timestamptz(3)
  replacedAt            DateTime?                   @map("replaced_at") @db.Timestamptz(3)
  acceptedByUserId      String?                     @map("accepted_by_user_id") @db.Uuid
  issuedByMembershipId  String                      @map("issued_by_membership_id") @db.Uuid
  revokedByMembershipId String?                     @map("revoked_by_membership_id") @db.Uuid
  revocationReason      InvitationRevocationReason? @map("revocation_reason")
  createdAt             DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization        Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  acceptedBy          User?                   @relation(fields: [acceptedByUserId, invitedEmail], references: [id, email], onDelete: Restrict, onUpdate: Restrict)
  branchScopes        InvitationBranchScope[]
  issuedByMembership  OrganizationMembership  @relation("InvitationIssuer", fields: [organizationId, issuedByMembershipId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  revokedByMembership OrganizationMembership? @relation("InvitationRevoker", fields: [organizationId, revokedByMembershipId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  sourcedMembership   OrganizationMembership? @relation("MembershipSourceInvitation")

  @@unique([id, organizationId], map: "invitations_id_organization_id_key")
  @@index([organizationId, invitedEmail], map: "invitations_organization_id_invited_email_idx")
  @@index([acceptedByUserId], map: "invitations_accepted_by_user_id_idx")
  @@map("invitations")
}

model InvitationBranchScope {
  organizationId String @map("organization_id") @db.Uuid
  invitationId   String @map("invitation_id") @db.Uuid
  branchId       String @map("branch_id") @db.Uuid

  invitation Invitation @relation(fields: [invitationId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  branch     Branch     @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)

  @@id([organizationId, invitationId, branchId], map: "invitation_branch_scopes_pkey")
  @@index([invitationId, organizationId], map: "invitation_branch_scopes_invitation_organization_idx")
  @@index([branchId, organizationId], map: "invitation_branch_scopes_branch_organization_idx")
  @@map("invitation_branch_scopes")
}

model MembershipAccessEvent {
  id                 String                    @id @default(uuid()) @db.Uuid
  organizationId     String                    @map("organization_id") @db.Uuid
  targetMembershipId String                    @map("target_membership_id") @db.Uuid
  actorUserId        String                    @map("actor_user_id") @db.Uuid
  actorMembershipId  String?                   @map("actor_membership_id") @db.Uuid
  eventType          MembershipAccessEventType @map("event_type")
  beforeRole         OrganizationRole?         @map("before_role")
  beforeStatus       MembershipStatus?         @map("before_status")
  afterRole          OrganizationRole          @map("after_role")
  afterStatus        MembershipStatus          @map("after_status")
  occurredAt         DateTime                  @default(now()) @map("occurred_at") @db.Timestamptz(3)

  targetMembership OrganizationMembership             @relation("MembershipAccessEventTarget", fields: [organizationId, targetMembershipId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  actorUser        User                               @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actorMembership  OrganizationMembership?            @relation("MembershipAccessEventActor", fields: [organizationId, actorMembershipId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  branchScopes     MembershipAccessEventBranchScope[]

  @@unique([id, organizationId], map: "membership_access_events_id_organization_id_key")
  @@index([organizationId, targetMembershipId, occurredAt], map: "membership_access_events_target_time_idx")
  @@index([actorUserId, occurredAt], map: "membership_access_events_actor_time_idx")
  @@map("membership_access_events")
}

model MembershipAccessEventBranchScope {
  organizationId String @map("organization_id") @db.Uuid
  eventId        String @map("event_id") @db.Uuid
  branchId       String @map("branch_id") @db.Uuid

  event  MembershipAccessEvent @relation(fields: [eventId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
  branch Branch                @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)

  @@id([organizationId, eventId, branchId], map: "membership_access_event_branch_scopes_pkey")
  @@index([branchId, organizationId], map: "membership_access_event_branch_scopes_branch_organization_idx")
  @@map("membership_access_event_branch_scopes")
}

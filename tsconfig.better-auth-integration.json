{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "typeRoots": ["./apps/api/node_modules/@types"],
    "types": ["node"]
  },
  "include": [
    "tests/e2e/better-auth-integration/**/*.ts",
    "tests/e2e/better-auth-integration/**/*.mts",
    "playwright.better-auth-integration.config.ts",
    "vitest.better-auth-integration-db.config.mts",
    "vitest.better-auth-integration-legacy.config.mts"
  ]
}
